---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import links from '../content/links.json';
---

<header class="m-0 bg-(--seagfoam) shadow-[0_2px_8px_rgba(var(--black),0.05)]">
	<nav class="flex items-center justify-between">
		<h2 class="pl-8 m-0 text-[1em]">
			<a href="/" class="text-(--off-white) no-underline hover:text-(--off-white)">
				{SITE_TITLE}
			</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/resume">Resume</HeaderLink>
		</div>
		<div class="pr-8 hidden md:flex gap-2">
			{links.map((link: { href: string; icon: string; screenReaderText: string }) => (
				<a href={link.href} target="_blank" class="flex text-(--off-white) hover:text-teal-500">
					<span class="sr-only">{link.screenReaderText}</span>
					<i class={`${link.icon} text-2xl`} aria-hidden="true"></i>
				</a>
			))}
		</div>
	</nav>
	<div class="flex h-2" aria-hidden="true">
		<div class="flex-1 bg-[var(--stripe-red)]"></div>
		<div class="flex-1 bg-[var(--stripe-orange)]"></div>
		<div class="flex-1 bg-[var(--stripe-yellow)]"></div>
	</div>
</header>
