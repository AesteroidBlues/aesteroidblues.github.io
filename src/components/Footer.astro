---
import links from '../content/links.json';
const today = new Date();
---

<footer
	class="px-4 pt-8 pb-8 text-center text-[rgb(var(--gray))]"
>
	&copy; {today.getFullYear()} Alex Ferbrache. All rights reserved.
	<div class="flex justify-center gap-4 mt-4">
		{links.map((link: { href: string; icon: string; screenReaderText: string }) => (
			<a href={link.href} target="_blank" class="flex no-underline text-[rgb(var(--gray))] hover:text-[rgb(var(--gray-dark))]">
				<span class="sr-only">{link.screenReaderText}</span>
				<i class={`${link.icon} text-2xl`} aria-hidden="true"></i>
			</a>
		))}
	</div>
</footer>
