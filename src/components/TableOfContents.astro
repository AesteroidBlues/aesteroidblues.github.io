---
---
<aside id="toc-container" class="hidden xl:block w-64 shrink-0 self-start sticky top-16">
	<nav
		id="toc"
		class="max-h-[calc(100vh-4rem)] overflow-y-auto text-sm"
	>
		<p class="mb-3 font-semibold text-(--off-white) uppercase tracking-wider text-xs">
			On this page
		</p>
		<ul id="toc-list" class="space-y-1 border-l border-[rgb(var(--gray-light))]"></ul>
	</nav>
</aside>

<script>
	function buildToc() {
		const article = document.querySelector('article');
		const list = document.getElementById('toc-list');
		if (!article || !list) return;

		const headings = Array.from(article.querySelectorAll('h1, h2, h3, h4'));
		if (headings.length === 0) return;

		// Assign IDs to headings that don't have one
		headings.forEach((h, i) => {
			if (!h.id) {
				h.id = `heading-${i}`;
			}
		});

		headings.forEach((h) => {
			const level = parseInt(h.tagName[1]);
			const indent = (level - 1) * 12;

			const li = document.createElement('li');
			const a = document.createElement('a');
			a.href = `#${h.id}`;
			a.textContent = h.textContent ?? '';
			a.dataset.headingId = h.id;
			a.style.paddingLeft = `${indent + 12}px`;
			a.className =
				'block py-1 pr-2 text-[rgb(var(--gray))] hover:text-[rgb(var(--accent))] transition-colors duration-150 leading-snug border-l-2 border-transparent -ml-px';
			li.appendChild(a);
			list.appendChild(li);
		});

		const links = list.querySelectorAll<HTMLAnchorElement>('a[data-heading-id]');

		function setActive(id: string) {
			links.forEach((l) => {
				const active = l.dataset.headingId === id;
				l.classList.toggle('border-[rgb(var(--accent))]', active);
				l.classList.toggle('border-transparent', !active);
				l.classList.toggle('text-[rgb(var(--accent))]', active);
				l.classList.toggle('text-[rgb(var(--gray))]', !active);
			});
		}

		function onScroll() {
			const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 8;
			if (atBottom) {
				setActive(headings[headings.length - 1].id);
				return;
			}
			const scrollY = window.scrollY;
			let active = headings[0];
			for (const h of headings) {
				if (h.getBoundingClientRect().top + scrollY <= scrollY + window.innerHeight * 0.25) {
					active = h;
				}
			}
			if (active) setActive(active.id);
		}

		window.addEventListener('scroll', onScroll, { passive: true });
		onScroll();
	}

	buildToc();
</script>
