---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h2>I'm Alex.</h2>
			<p>I love building games that delight players. I have 11 years of industry experience and 
				a proven track record of delivering features from prototype to shipped product.</p>
		</main>
		<Footer />
	</body>
</html>
